# Copia este archivo a mapbox.env y pega tu token público de Mapbox
# (cuenta -> Access tokens -> public token pk....). mapbox.env está en .gitignore.
# Se inyecta en compilación con --dart-define-from-file=mapbox.env (lo usan
# .vscode/settings.json, .vscode/launch.json y build_apk.sh), así el token llega
# a Dart (geocoding del buscador) y a MapboxOptions para el mapa.
# Si no hay --dart-define, Dart obtiene el token del lado nativo (canal
# rmdeveloper/mapbox_access_token) y el mapa funciona igual.
ACCESS_TOKEN=

# --- Android (token nativo, gitignored) ---
# Crea android/app/src/main/res/values/mapbox_token.xml (está en .gitignore):
#   <?xml version="1.0" encoding="utf-8"?>
#   <resources>
#       <string name="mapbox_access_token" translatable="false">pk....</string>
#   </resources>

# --- iOS (token nativo, gitignored) ---
# Crea ios/Flutter/mapbox_token.xcconfig (está en .gitignore):
#   MAPBOX_ACCESS_TOKEN=pk....
# Se sustituye en Info.plist (MGLMapboxAccessToken) y lo lee el canal nativo.

# NOTA: con los archivos nativos de cada plataforma, el mapa carga sin importar
# cómo ejecutes la app; el buscador (geocoding) también, porque Dart resuelve el
# token del canal nativo cuando falta el --dart-define.